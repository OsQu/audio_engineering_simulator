/target
**/*.rs.bk

# Offline render outputs (Epic 2 harness). Committed golden references live elsewhere.
/renders

# wasm-pack build output (regenerated by `wasm-pack build`; see crates/wasm-bindings/README.md).
# Covers the default `pkg/` and the benchmark's `pkg-scalar/` + `pkg-simd/` variants.
/crates/wasm-bindings/pkg*

.DS_Store

# Playwright artifacts are produced only by browser-test runs.
/web/test-results/
/web/playwright-report/

# Playwright MCP session output (snapshots, console logs, screenshots) from live verification runs —
# see .claude/skills/verify-live. Lands wherever the MCP's cwd is, so match it at any depth.
.playwright-mcp/
